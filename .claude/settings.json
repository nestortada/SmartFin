{
  "env": {
    "TZ": "America/Bogota"
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(npm test *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run lint *)",
      "Bash(npm run test:reproductions *)",
      "Bash(npm run skills:check *)",
      "Bash(npm run skills:sync *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(node --test .claude/hooks/__tests__/*)",
      "Bash(node --test .codex/hooks/__tests__/*)",
      "Bash(npx jest *)",
      "Bash(npx eslint *)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git ls-files *)",
      "Bash(git blame *)",
      "Bash(git worktree list *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(npm test *)",
      "PowerShell(npm run typecheck *)",
      "PowerShell(npm run lint *)",
      "PowerShell(npm run test:reproductions *)",
      "PowerShell(npm run skills:check *)",
      "PowerShell(npm run skills:sync *)",
      "PowerShell(npx tsc --noEmit *)",
      "PowerShell(node --test .claude/hooks/__tests__/*)",
      "PowerShell(node --test .codex/hooks/__tests__/*)",
      "PowerShell(npx jest *)",
      "PowerShell(npx eslint *)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git merge-base *)",
      "PowerShell(git ls-files *)",
      "PowerShell(git blame *)",
      "PowerShell(git worktree list *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.db)",
      "Read(**/*.db-wal)",
      "Read(**/*.db-shm)",
      "Read(**/*.db-journal)",
      "Read(**/*.sqlite)",
      "Read(**/*.sqlite3)",
      "Read(**/smartfin-local-snapshots/**)",
      "Read(**/smartfin-backup-jobs/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|powershell|Write|Edit|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dangerous-command-guard.cjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|PowerShell|powershell)$",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/reviewer-reminder.cjs\" verified",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/reviewer-reminder.cjs\" baseline",
            "timeout": 10
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/reviewer-reminder.cjs\" stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
